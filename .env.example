# football-news-automation environment configuration template
# Copy to .env for local testing (DO NOT commit your actual .env file!)

# LLM Configuration (OpenAI API)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_CONFIDENCE_THRESHOLD=0.75

# Meta Graph API (Facebook Page)
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_TOKEN=your_never_expiring_page_access_token_here
GRAPH_API_VERSION=v20.0

# Publishing Controls & Safety Modes
DRY_RUN=true
APPROVAL_REQUIRED=false

# Daily & Scheduling Rate Limits
DAILY_LIMIT=35
MAX_POSTS_PER_RUN=4
MIN_POST_INTERVAL_MINUTES=20
TIMEZONE=Africa/Cairo
QUIET_HOURS_START=02:00
QUIET_HOURS_END=07:00

# Image Configuration
FALLBACK_IMAGE_PATH=assets/default_football.jpg
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
USE_STOCK_IMAGES=false

# Feeds Configuration
FEEDS_CONFIG_PATH=config/feeds.json
MAX_ARTICLE_AGE_HOURS=24
REQUEST_TIMEOUT_SECONDS=15
